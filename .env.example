# CosmosBot Backend Environment Variables Template

# Web server port (Render populates $PORT automatically)
PORT=5000

# CORS Allowed Origins
# Leave as '*' to allow all origins, or specify your Vercel deployment URL(s):
# CORS_ORIGINS=https://your-cosmos-bot.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=*

# Optional: Disable external web search fallback (default: false)
DISABLE_WEB_SEARCH=false

# Flask debug mode (always keep false for production on Render)
FLASK_DEBUG=false
